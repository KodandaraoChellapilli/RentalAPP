generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  phone        String?
  customerId   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  customer       Customer?         @relation(fields: [customerId], references: [id])
  timeEntries    TimeEntry[]
  photos         Photo[]
  assignedEvents ScheduleEvent[]
  documents      CustomerDocument[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  users     User[]
  rentals   Rental[]
  events    ScheduleEvent[]
  invoices  Invoice[]
  documents CustomerDocument[]
}

model Equipment {
  id          String   @id @default(cuid())
  number      String   @unique
  name        String
  type        String
  status      String   @default("AVAILABLE")
  rate        Float
  billingUnit String   @default("DAILY")
  notes       String?
  createdAt   DateTime @default(now())

  rentals  Rental[]
  photos   Photo[]
  events   ScheduleEvent[]
  invoices Invoice[]
}

model Rental {
  id                  String    @id @default(cuid())
  equipmentId         String
  customerId          String
  status              String    @default("SCHEDULED")
  destination         String?
  startAt             DateTime?
  endAt               DateTime?
  expectedPickupAt    DateTime?
  rateSnapshot        Float
  billingUnitSnapshot String
  finalAmount         Float?
  notes               String?
  createdAt           DateTime  @default(now())

  equipment Equipment       @relation(fields: [equipmentId], references: [id])
  customer  Customer        @relation(fields: [customerId], references: [id])
  photos    Photo[]
  events    ScheduleEvent[]
  invoice   Invoice?
}

model TimeEntry {
  id         String    @id @default(cuid())
  employeeId String
  clockIn    DateTime
  clockOut   DateTime?
  notes      String?

  employee User @relation(fields: [employeeId], references: [id])
}

model ScheduleEvent {
  id                   String    @id @default(cuid())
  type                 String
  title                String?
  startAt              DateTime
  endAt                DateTime?
  equipmentId          String?
  customerId           String?
  employeeId           String?
  rentalId             String?
  notes                String?
  destination          String?
  completedAt          DateTime?
  source               String    @default("STAFF")
  customerConfirmedAt  DateTime?
  createdAt            DateTime  @default(now())

  equipment Equipment? @relation(fields: [equipmentId], references: [id])
  customer  Customer?  @relation(fields: [customerId], references: [id])
  employee  User?      @relation(fields: [employeeId], references: [id])
  rental    Rental?    @relation(fields: [rentalId], references: [id])
  photos    Photo[]
}

model Photo {
  id           String   @id @default(cuid())
  equipmentId  String
  rentalId     String?
  eventId      String?
  uploadedById String?
  type         String
  path         String
  takenAt      DateTime @default(now())
  notes        String?

  equipment  Equipment      @relation(fields: [equipmentId], references: [id])
  rental     Rental?        @relation(fields: [rentalId], references: [id])
  event      ScheduleEvent? @relation(fields: [eventId], references: [id])
  uploadedBy User?          @relation(fields: [uploadedById], references: [id])
}

model Invoice {
  id          String    @id @default(cuid())
  number      String    @unique
  customerId  String
  rentalId    String    @unique
  equipmentId String
  status      String    @default("UNPAID")
  subtotal    Float
  total       Float
  dueDate     DateTime
  notes       String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  customer  Customer      @relation(fields: [customerId], references: [id])
  rental    Rental        @relation(fields: [rentalId], references: [id])
  equipment Equipment     @relation(fields: [equipmentId], references: [id])
  lines     InvoiceLine[]
}

model InvoiceLine {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float
  unitAmount  Float
  amount      Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model CustomerDocument {
  id           String   @id @default(cuid())
  customerId   String
  type         String
  name         String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id])
  uploadedBy User?    @relation(fields: [uploadedById], references: [id])
}
