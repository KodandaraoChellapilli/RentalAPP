{
  "expo": {
    "name": "West Ridge Rentals",
    "slug": "ridgeline-rentals",
    "scheme": "ridgeline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14110e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.westridgerentals.app",
      "infoPlist": {
        "NSCameraUsageDescription": "West Ridge Rentals uses the camera to photograph equipment before delivery and after pickup.",
        "NSPhotoLibraryUsageDescription": "West Ridge Rentals uses your photo library so you can attach equipment condition photos.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.westridgerentals.app",
      "adaptiveIcon": {
        "backgroundColor": "#14110E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "INTERNET"],
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "West Ridge Rentals uses photos to record equipment condition.",
          "cameraPermission": "West Ridge Rentals uses the camera to photograph equipment before delivery and after pickup."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
